rules_version = '2';

// AFMN Lab website — Firestore security rules (same model as the ACS GSTU Chapter Editor).
//
//   site/meta              public   revision counter; public pages compare it with their baked copy
//   content/{section}      public   one document per editable section: { data, revision, updatedAt, updatedBy, updatedByEmail, auditId }
//   siteImages/{id}        public   uploaded, optimized JPEG images (media:<id>)
//   labEditors/{email}     private  dashboard access granted by a super-admin
//   auditLogs/{id}         private  append-only activity log with server timestamps
//   removals/{key}         private  ties each deletion to its log entry
//
// LabBoard (instrument board at /update, source in labboard/) shares this project. Its collections are
// users, allowlist, instruments, sessions, bookings, templates, issues, maintenance, labImages; see the LabBoard section
// at the end of this file. The two apps use different collections and never touch each other's documents.
//
// Only Google sign-in counts. Every write carries an auditId; the rules check that the log entry is
// created in the same request, by the same person, with the same server time.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity

    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return email() == 'muhammadshamsularefin01@gmail.com'; }
    function grantPath() { return /databases/$(database)/documents/labEditors/$(email()); }
    function grantedRole() {
      return exists(grantPath()) && get(grantPath()).data.active == true ? get(grantPath()).data.role : '';
    }
    function role() { return !signedInWithGoogle() ? '' : isOwner() ? 'super-admin' : grantedRole(); }
    function isSuperAdmin() { return role() == 'super-admin'; }
    function isEditor() { return role() in ['super-admin', 'editor', 'contributor']; }
    function maySection(section) {
      return role() in ['super-admin', 'editor']
        || (role() == 'contributor' && section in ['news', 'publications', 'gallery']);
    }

    // ---------------------------------------------------------------- audit

    function logAt(id) { return getAfter(/databases/$(database)/documents/auditLogs/$(id)).data; }
    function freshLog(id) {
      return id is string && id.size() > 0 && id.size() <= 40
        && logAt(id).actorUid == request.auth.uid && logAt(id).createdAt == request.time;
    }
    function audited(id, action, target) {
      return freshLog(id) && logAt(id).action == action && logAt(id).target == target;
    }
    function removed(key, action, target) {
      return audited(getAfter(/databases/$(database)/documents/removals/$(key)).data.auditId, action, target);
    }
    function nextRevision() {
      let d = request.resource.data;
      return d.revision is int && d.revision == (resource == null ? 1 : resource.data.get('revision', 0) + 1);
    }

    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'target', 'detail', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == email()
        && request.resource.data.createdAt == request.time
        && request.resource.data.action in ['content.update', 'image.add', 'image.delete', 'access.set', 'access.delete']
        && request.resource.data.target is string && request.resource.data.target.size() <= 200
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 1000;
      allow update, delete: if false;
    }

    match /removals/{key} {
      allow read: if isSuperAdmin();
      allow create, update: if isEditor() && request.resource.data.keys().hasOnly(['auditId']) && freshLog(request.resource.data.auditId);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- website content

    match /site/{doc} {
      allow get: if doc == 'meta';
      allow list: if false;
      allow create, update: if doc == 'meta' && isEditor()
        && request.resource.data.keys().hasOnly(['revision', 'section', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && nextRevision() && request.resource.data.section is string && request.resource.data.section.size() <= 40
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == email();
      allow delete: if false;
    }

    match /content/{section} {
      allow get, list: if true;
      allow create, update: if section in ['site', 'notices', 'home', 'pi', 'research', 'instruments', 'team', 'publications', 'news', 'openings', 'gallery', 'teaching']
        && maySection(section)
        && request.resource.data.keys().hasOnly(['data', 'revision', 'updatedAt', 'updatedBy', 'updatedByEmail', 'auditId'])
        && request.resource.data.data is map
        && nextRevision()
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == email()
        && audited(request.resource.data.auditId, 'content.update', section);
      allow delete: if false;
    }

    match /siteImages/{id} {
      allow get: if true;
      allow list: if isEditor();
      allow create: if isEditor() && id.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['image', 'name', 'createdBy', 'createdByEmail', 'createdAt', 'auditId'])
        && request.resource.data.image is string && request.resource.data.image.size() <= 280000
        && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByEmail == email()
        && request.resource.data.createdAt == request.time
        && audited(request.resource.data.auditId, 'image.add', id);
      allow update: if false;
      allow delete: if isEditor() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid)
        && removed('siteImages:' + id, 'image.delete', id);
    }

    // ---------------------------------------------------------------- access

    match /labEditors/{editor} {
      allow get: if signedInWithGoogle() && (isSuperAdmin() || email() == editor);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && editor != 'muhammadshamsularefin01@gmail.com'
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'auditId', 'updatedAt', 'updatedBy'])
        && request.resource.data.email == editor && editor.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.role in ['super-admin', 'editor', 'contributor'] && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && audited(request.resource.data.auditId, 'access.set', editor);
      allow delete: if isSuperAdmin() && editor != 'muhammadshamsularefin01@gmail.com'
        && removed('labEditors:' + editor, 'access.delete', editor);
    }

    // ================================================================ LabBoard (instrument board, /update)
    //
    // Roles: admin  - manage instruments, users, maintenance, everything
    //        member - start/finish their own sessions, book, templates, report issues
    //        guest  - read-only (e.g. the lab monitor); may report issues
    // A users/{uid} document is created by the app on first sign-in. Its role and `approved` flag are only
    // accepted when they match the allowlist entry for that email (or the owner, or the optional domain
    // below). Anyone else is stored as a pending guest until an admin approves them.

    // Optional: Google accounts on this domain are approved as members automatically. Disabled ('^$' never
    // matches) so that only people on the approved list get in. To enable, e.g.: '.*@gstu[.]edu[.]bd$'
    function lbDomainRegex() { return '^$'; }

    function lbUserPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function lbInstPath(id) { return /databases/$(database)/documents/instruments/$(id); }
    function lbAllowPath(mail) { return /databases/$(database)/documents/allowlist/$(mail); }

    function lbHasProfile() { return signedInWithGoogle() && exists(lbUserPath(request.auth.uid)); }
    function lbMe() { return get(lbUserPath(request.auth.uid)).data; }
    function lbApproved() { return lbHasProfile() && lbMe().approved == true; }
    function lbMember() { return lbApproved() && lbMe().role in ['member', 'admin']; }
    function lbAdmin() { return lbApproved() && lbMe().role == 'admin'; }

    // Restricted instruments need the instrument id in the user's trainedOn list (admins are exempt).
    function lbTrainedFor(instrumentId) {
      let inst = get(lbInstPath(instrumentId)).data;
      return inst.get('restricted', false) == false
          || lbMe().role == 'admin'
          || instrumentId in lbMe().get('trainedOn', []);
    }
    function lbInService(instrumentId) {
      return get(lbInstPath(instrumentId)).data.get('status', 'ok') != 'out_of_service';
    }
    function lbUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    function lbOnlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The role/approval a person may give themselves.
    function lbValidSelfAccess(d) {
      let listed = exists(lbAllowPath(email()));
      return (isOwner() && d.role == 'admin' && d.approved == true)
          || (listed
               && d.role == get(lbAllowPath(email())).data.role
               && d.approved == true)
          || (!listed
               && email().matches(lbDomainRegex())
               && d.role == 'member'
               && d.approved == true)
          || (d.role == 'guest' && d.approved == false);
    }

    match /users/{uid} {
      allow read: if (signedInWithGoogle() && request.auth.uid == uid) || lbApproved();

      allow create: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.trainedOn == []
        && lbValidSelfAccess(request.resource.data);

      allow update: if lbAdmin()
        // own profile cosmetics
        || (signedInWithGoogle() && request.auth.uid == uid
            && lbOnlyChanges(['name', 'photoURL', 'lastLoginAt', 'notify']))
        // self-upgrade when an admin has since added you to the allowlist
        || (signedInWithGoogle() && request.auth.uid == uid
            && lbOnlyChanges(['role', 'approved', 'name', 'photoURL', 'lastLoginAt'])
            && lbValidSelfAccess(request.resource.data)
            && request.resource.data.approved == true);

      allow delete: if lbAdmin();
    }

    // allowlist: doc id = lower-case email
    match /allowlist/{mail} {
      allow read: if lbAdmin() || (signedInWithGoogle() && email() == mail);
      allow write: if lbAdmin()
        && (request.resource == null || request.resource.data.role in ['admin', 'member', 'guest']);
    }

    match /instruments/{id} {
      allow read: if lbApproved();
      allow create, delete: if lbAdmin();

      allow update: if lbAdmin()
        // A member claims a free instrument for a session they create in the same batch/transaction.
        || (lbMember()
            && lbOnlyChanges(['activeSession', 'freeSince'])
            && resource.data.get('activeSession', null) == null
            && resource.data.get('status', 'ok') != 'out_of_service'
            && request.resource.data.activeSession.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.activeSession.sessionId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.activeSession.sessionId)).data.instrumentId == id)
        // The session owner releases the instrument when finishing.
        || (lbMember()
            && lbOnlyChanges(['activeSession', 'freeSince'])
            && resource.data.get('activeSession', null) != null
            && resource.data.activeSession.uid == request.auth.uid
            && request.resource.data.activeSession == null);
    }

    match /sessions/{id} {
      allow read: if lbApproved();

      allow create: if lbMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.expectedEnd is timestamp
        && request.resource.data.expectedEnd > request.time
        && request.resource.data.sample is string
        && request.resource.data.sample.size() <= 200
        && request.resource.data.params is list
        && request.resource.data.params.size() <= 40
        && lbTrainedFor(request.resource.data.instrumentId)
        && lbInService(request.resource.data.instrumentId);

      // Only the session owner edits their session (admins may force-finish).
      allow update: if (lbMember()
            && resource.data.userId == request.auth.uid
            && lbUnchanged('userId') && lbUnchanged('instrumentId') && lbUnchanged('startedAt')
            && request.resource.data.status in ['active', 'finished'])
        || lbAdmin();

      allow delete: if lbAdmin();
    }

    function lbValidBookingTimes(d) {
      let maxH = get(lbInstPath(d.instrumentId)).data.get('maxBookingHours', 12);
      return d.start is timestamp && d.end is timestamp
          && d.end > d.start
          && d.end <= d.start + duration.value(maxH, 'h');
    }

    match /bookings/{id} {
      allow read: if lbApproved();

      allow create: if lbMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'booked'
        && request.resource.data.end > request.time
        && lbValidBookingTimes(request.resource.data)
        && lbTrainedFor(request.resource.data.instrumentId)
        && lbInService(request.resource.data.instrumentId);

      allow update: if
        // Owner cancels or marks the booking as started
        (lbMember()
          && resource.data.userId == request.auth.uid
          && request.resource.data.status in ['started', 'cancelled']
          && lbOnlyChanges(['status', 'sessionId', 'startedAt', 'cancelledAt']))
        // Owner moves / resizes their booking
        || (lbMember()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'booked'
          && request.resource.data.status == 'booked'
          && lbOnlyChanges(['start', 'end', 'purpose'])
          && request.resource.data.end > request.time
          && lbValidBookingTimes(request.resource.data))
        // Any approved user may auto-release a no-show 30 minutes after its start
        || (lbApproved()
          && resource.data.status == 'booked'
          && request.time > resource.data.start + duration.value(30, 'm')
          && request.resource.data.status == 'released'
          && lbOnlyChanges(['status', 'releasedAt']))
        || lbAdmin();

      allow delete: if lbAdmin() || (lbMember() && resource.data.userId == request.auth.uid);
    }

    // Saved parameter sets per instrument
    match /templates/{id} {
      allow read: if lbApproved();
      allow create: if lbMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.params is list
        && request.resource.data.params.size() <= 40;
      allow update, delete: if lbAdmin()
        || (lbMember() && resource.data.createdBy == request.auth.uid && lbUnchanged('createdBy'));
    }

    match /issues/{id} {
      allow read: if lbApproved();
      allow create: if lbApproved()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && (!('photos' in request.resource.data)
            || (request.resource.data.photos is list && request.resource.data.photos.size() <= 4));
      allow update, delete: if lbAdmin();
    }

    match /maintenance/{id} {
      allow read: if lbApproved();
      allow write: if lbAdmin();
    }

    // Uploaded photos (instrument pictures, issue photos). Spark has no Cloud Storage, so the browser
    // shrinks each image to a JPEG of at most ~280 KB and stores it here as a data URL; content refers to
    // it as lbimg:<id>. Images never change; the uploader or an admin deletes them.
    match /labImages/{id} {
      allow read: if lbApproved();
      allow create: if lbApproved()
        && request.resource.data.keys().hasOnly(['image', 'name', 'kind', 'createdBy', 'createdByName', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['instrument', 'issue', 'other']
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && request.resource.data.image is string && request.resource.data.image.size() <= 280000
        && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        // Instrument photos are an admin job; anyone approved may attach photos to an issue report.
        && (request.resource.data.kind != 'instrument' || lbAdmin());
      allow delete: if lbAdmin() || (lbApproved() && resource.data.createdBy == request.auth.uid);
      allow update: if false;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
