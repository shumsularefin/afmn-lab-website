{
  "name": "labboard",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-labboard-test \"node --test tests/rules.test.mjs\"",
