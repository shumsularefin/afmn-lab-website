# Normally NOT needed: on Firebase Hosting the app reads its Firebase config from /__/firebase/init.json.
# Set these only for local development against a project or the emulators (copy to .env.local).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=afmn-lab.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=afmn-lab
# VITE_FIREBASE_APP_ID=

# Emulators (npm run emulators in the repo root, then `npm run dev:emu` here):
# VITE_USE_EMULATORS=true

# Shown on the login page only; the real domain check lives in ../firestore.rules (allowedDomainRegex).
# VITE_ALLOWED_DOMAIN=
